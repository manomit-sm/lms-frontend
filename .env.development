# Local development (vite dev). Every portal reads this file; nothing here has a default in code.

# Backend that the dev servers proxy /api, /platform and /local to (so the browser never needs CORS)
LMS_BACKEND_URL=http://localhost:8080

# Empty: call the API on the portal's own origin, i.e. through the dev proxy
VITE_API_BASE_URL=

# Where the portals link to each other
VITE_EMPLOYEE_PORTAL_URL=http://localhost:5173
VITE_ADMIN_PORTAL_URL=http://localhost:5174
