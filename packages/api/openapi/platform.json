  "components": {
    "schemas": {
      "CreateTenantRequest": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z][a-z0-9-]{1,38}[a-z0-9]$"
          },
          "name": {
            "type": "string",
            "maxLength": 200,
            "minLength": 0
          },
          "subdomain": {
            "type": "string",
            "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$"
          },
          "defaultTimezone": {
            "type": "string",
            "minLength": 1
          },
          "adminEmail": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "adminEmail",
          "defaultTimezone",
          "key",
          "name"
        ]
      },
      "TenantResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "key": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "schemaName": {
            "type": "string"
          },
          "subdomain": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "PROVISIONING",
              "ACTIVE",
              "SUSPENDED",
              "DEACTIVATED"
            ]
          },
          "migrationState": {
            "type": "string",
            "enum": [
              "PENDING",
              "UP_TO_DATE",
              "FAILED"
            ]
          },
          "migratedAt": {
            "type": "string",
            "format": "date-time"
          },
          "migrationError": {
            "type": "string"
          },
          "defaultTimezone": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AddTenantAdminRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "minLength": 0
          }
        },
        "required": [
          "email"
        ]
      },
      "PageResponseTenantResponse": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TenantResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int32"
          },
          "size": {
            "type": "integer",
            "format": "int32"
          },
          "totalElements": {
            "type": "integer",
            "format": "int64"
          },
          "totalPages": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ProblemDetail": {
        "type": "object",
        "description": "RFC 9457 problem details. `x-error-codes` gives each code's HTTP status.",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "format": "int32"
          },
          "detail": {
            "type": "string",
            "description": "Human-readable; safe to show to the user"
          },
          "instance": {
            "type": "string"
          },
          "errorCode": {
            "type": "string",
            "description": "Stable, machine-readable error code",
            "enum": [
              "ACCESS_DENIED",
              "ALREADY_HELD",
              "APPROVAL_ALREADY_PENDING",
              "ATTACHMENT_NOT_FOUND",
              "ATTACHMENT_NOT_UPLOADED",
              "ATTACHMENT_REQUIRED",
              "BACKDATING_NOT_ALLOWED",
              "BAD_REQUEST",
              "BALANCE_NOT_FOUND",
              "BEFORE_JOINING",
              "CANNOT_DISABLE_SELF",
              "COMMENT_REQUIRED",
              "CONCURRENT_UPDATE",
              "CONFLICT",
              "CROSSES_LEAVE_PERIOD",
              "DEFAULT_WORKFLOW_FIXED",
              "DEFAULT_WORK_SCHEDULE_REQUIRED",
              "DEPARTMENT_CODE_TAKEN",
              "DEPARTMENT_CYCLE",
              "DEPARTMENT_NOT_FOUND",
              "DEPARTMENT_NOT_VISIBLE",
              "DESIGNATION_NAME_TAKEN",
              "DESIGNATION_NOT_FOUND",
              "EMAIL_LINKED_TO_OTHER_EMPLOYEE",
              "EMAIL_REGISTERED_ELSEWHERE",
              "EMPLOYEE_CODE_TAKEN",
              "EMPLOYEE_EMAIL_TAKEN",
              "EMPLOYEE_EXITED",
              "EMPLOYEE_HAS_REPORTS",
              "EMPLOYEE_NOT_FOUND",
              "EMPLOYEE_NOT_VISIBLE",
              "EXPORT_NOT_FOUND",
              "EXPORT_NOT_READY",
              "EXPORT_TOO_LARGE",
              "HALF_DAY_NOT_ALLOWED",
              "HOLIDAY_ALREADY_EXISTS",
              "HOLIDAY_NOT_FOUND",
              "INSUFFICIENT_BALANCE",
              "INSUFFICIENT_NOTICE",
              "INTERNAL_ERROR",
              "INVALID_AMOUNT",
              "INVALID_DATES",
              "INVALID_DATE_RANGE",
              "INVALID_EFFECTIVE_DATES",
              "INVALID_EMPLOYMENT_STATUS",
              "INVALID_HOLIDAY_IMPORT",
              "INVALID_LEAVE_PERIOD",
              "INVALID_RANGE",
              "INVALID_SCOPE",
              "INVALID_SESSIONS",
              "INVALID_STATUS_TRANSITION",
              "INVALID_TENANT_STATE",
              "INVALID_TIMEZONE",
              "INVALID_WORKFLOW",
              "LAST_TENANT_ADMIN",
              "LEAVE_PERIOD_CLOSED",
              "LEAVE_PERIOD_NAME_TAKEN",
              "LEAVE_PERIOD_NOT_FOUND",
              "LEAVE_PERIOD_OVERLAP",
